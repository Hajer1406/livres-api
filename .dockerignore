# Répertoires de build Maven (jamais envoyés au daemon Docker)
target/
.mvn/wrapper/maven-wrapper.jar

# Fichiers d'IDE et de configuration locale
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# Fichiers secrets et d'environnement (sécurité Atelier 1)
.env
.env.*
!.env.example

