.git/
.gitignore
.gitattributes

# Documentation (inutile dans l'image de production)
docs/
README.md
HELP.md

# Scripts d'outillage (inutiles dans l'image)
scripts/

# Logs
*.log
logs/

# Fichiers OS
.DS_Store
Thumbs.db
